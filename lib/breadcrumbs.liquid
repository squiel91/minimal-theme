{%- # Breadcrumb trail: Inicio / [parent] / current. Args: current, parent_label, parent_url (optional). -%}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Inicio</a></li>
    {%- if parent_label -%}
      <li class="breadcrumbs__middle"><span aria-hidden="true">/</span><a href="{{ parent_url }}">{{ parent_label }}</a></li>
    {%- endif -%}
    <li class="breadcrumbs__current"><span aria-hidden="true">/</span><span aria-current="page">{{ current }}</span></li>
  </ol>
</nav>

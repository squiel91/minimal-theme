{% metadata title: 'Página no encontrada', robots: 'noindex' %}

<section class="wrap hero">
  <p class="eyebrow">Error 404</p>
  <h1 class="display hero__title">No encontramos esta página.</h1>
  <div class="hero__foot">
    <p class="hero__text">Puede que el enlace esté mal escrito o que el contenido ya no exista.</p>
    <div class="hero__actions">
      <a class="btn btn--primary btn--xl" href="/">Volver al inicio</a>
      <a class="arrow-link" href="/categorias/todas"><span>Ver productos</span>{% render 'lib/icons/arrow-right' %}</a>
    </div>
  </div>
</section>
